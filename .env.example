# Copy to .env at the repo root and fill in. Never commit .env.

# Jira Cloud (the only integration implemented so far)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# The story-points field id differs per Jira site. Find it with
# `python scripts/check_connection.py` (run from backend/) and paste it here.
JIRA_STORY_POINTS_FIELD=

# Add as each part is built:
# DATABASE_URL=postgresql://user:pass@localhost:5432/cognipm
# GEMINI_API_KEY=
