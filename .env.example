# Copy to .env at the repo root and fill in. Never commit .env.

# Jira Cloud. Use a sandbox project: approving a draft creates a real issue there.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# The story-points field id differs per Jira site. Find it with
# `python scripts/check_connection.py` (run from backend/) and paste it here.
JIRA_STORY_POINTS_FIELD=

# PostgreSQL for the API. `docker compose up` sets this itself and ignores any value here. You only need it when you run
# the API outside Docker (the developer route in the README), where it is postgresql://cognipm:cognipm@localhost:5433/cognipm. The tests use a SEPARATE database whose name contains "test": pass it on the command
# line (see README, "Run the tests"), never put it here, and never point the tests at this one.
# DATABASE_URL=postgresql://cognipm:cognipm@localhost:5432/cognipm

# Gemini, the model that drafts and answers. The key needs credit (an empty account fails with HTTP 402).
GEMINI_API_KEY=

# Browser origins allowed to call the API (the frontend URL when deployed). Default: the Vite dev server.
# CORS_ORIGINS=http://localhost:5173
# Issues one run may stage or create.
# COGNIPM_MAX_ITEMS_PER_RUN=20

# Signing in. The FIRST time the API starts with no accounts, it creates one PM from these (and does nothing after that,
# so changing them later never resets a password). More people can be added by a PM, or with scripts/create_user.py.
# The password needs at least 10 characters. A PM can approve; a developer can only look.
COGNIPM_ADMIN_EMAIL=ghii0002@student.monash.edu
COGNIPM_ADMIN_PASSWORD=Doufu4264!
# COGNIPM_ADMIN_NAME=Your Name
# Set to 1 when the site is served over https, so the sign-in cookie is only sent securely.
# COGNIPM_COOKIE_SECURE=1
